+}
+
+function renderNotableWeek(){
+  const el=$('#notableWeek');if(!el)return;
+  const jobs=payload.jobs||[];
+  // Score: size tier weight + posted pay weight. Skip confidential orgs.
+  const tierW={'$250M+':4,'$50M–$250M':3,'$10M–$50M':2,'Under $10M':1,'Size unknown':0};
+  const scored=jobs
