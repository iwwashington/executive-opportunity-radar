+function renderFirmMatrix(){
+  const el=$('#firmMatrix');if(!el)return;
+  const jobs=payload.jobs||[];
+  const firms={};
+  jobs.forEach(j=>{
+    const f=j.source||'Unknown';
+    firms[f]=firms[f]||{};
+    const t=sizeTier(j);
+    firms[f][t]=(firms[f][t]||0)+1;
+  });
+  const names=Object.keys(firms).sort((a,b)=>
+    Object.values(firms[b]).reduce((x,y)=>x+y,0)-Object.values(firms[a]).reduce((x,y)=>x+y,0)
+  ).slice(0,12);
+  const tiers=TIER_ORDER.filter(t=>names.some(f=>firms[f][t]));
+  let h=`<table style="border-collapse:collapse;font-size:12px;min-width:640px;width:100%">`;
+  h+=`<tr><th style="text-align:left;padding:8px;border-bottom:2px solid var(--line)">Firm</th>`+
+    tiers.map(t=>`<th style="padding:8px;border-bottom:2px solid var(--line);text-align:center">${esc(t)}</th>`).join('')+
+    `<th style="padding:8px;border-bottom:2px solid var(--line);text-align:center">Total</th></tr>`;
+  names.forEach(f=>{
+    const total=Object.values(firms[f]).reduce((x,y)=>x+y,0);
+    h+=`<tr><td style="padding:8px;border-bottom:1px solid var(--line);font-weight:700">${esc(f)}</td>`+
+      tiers.map(t=>{
+        const n=firms[f][t]||0;
+        const bg=n?`background:rgba(13,85,80,${Math.min(0.75,0.12+n*0.14)})`:'';
+        const fg=n&&n>=3?'color:#fff':'';
+        return `<td style="padding:8px;border-bottom:1px solid var(--line);text-align:center;${bg};${fg}">${n||''}</td>`;
+      }).join('')+
+      `<td style="padding:8px;border-bottom:1px solid var(--line);text-align:center;font-weight:700">${total}</td></tr>`;
+  });
+  h+=`</table>`;
+  el.innerHTML=h;
+}
