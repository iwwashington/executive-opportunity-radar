+function renderLeadInsight(){
+  const take=meta.market_take||{},comp=take.comparisons||{};
+  const el=$('#leadInsight');if(!el)return;
+  const overall=comp.new_searches;
+  let html='';
+  if(overall&&overall.trailing_4wk_avg>0){
+    const tw=overall.this_week,avg=overall.trailing_4wk_avg;
+    const pct=Math.round((tw-avg)/avg*100);
+    let verdict;
+    if(pct>=25)verdict=`running <strong>above</strong> its usual pace`;
+    else if(pct<=-25)verdict=`running <strong>below</strong> its usual pace`;
+    else verdict=`running <strong>near</strong> its usual pace`;
+    html+=`<div class="take-line lead-line">${tw} new searches surfaced this week vs a trailing 4-week average of ${avg} — the market is ${verdict}.</div>`;
+  }
+  // Sector-level insight: only when a sector deviates meaningfully.
+  const bySec=comp.by_sector||{};
+  const sig=Object.entries(bySec)
+    .filter(([s,v])=>v.trailing_4wk_avg>0&&v.this_week>=2)
+    .map(([s,v])=>({s,tw:v.this_week,avg:v.trailing_4wk_avg,
+      ratio:v.this_week/Math.max(v.trailing_4wk_avg,0.5)}))
+    .sort((a,b)=>b.ratio-a.ratio)[0];
+  if(sig&&sig.ratio>=1.8){
+    html+=`<div class="take-line">${esc(sig.s)} searches are running above their usual pace — ${sig.tw} this week vs a ${sig.avg}/week average.</div>`;
+  }else if(sig&&sig.ratio<=0.4){
+    html+=`<div class="take-line">${esc(sig.s)} searches are running below their usual pace — ${sig.tw} this week vs a ${sig.avg}/week average.</div>`;
+  }
+  // Fall back to the deterministic sentences when comparisons are thin.
+  if(!html){
