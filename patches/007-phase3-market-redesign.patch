+function sizeTier(j){
+  const r=j.org_revenue;
+  if(!r) return 'Size unknown';
+  if(r<10000000) return 'Under $10M';
+  if(r<50000000) return '$10M–$50M';
+  if(r<250000000) return '$50M–$250M';
+  return '$250M+';
 }
+const TIER_ORDER=['Under $10M','$10M–$50M','$50M–$250M','$250M+','Size unknown'];
