+function cleanOrgName(o){
+  if(!o)return '';
+  const s=String(o).trim();
+  if(s.length<4)return '';
+  const l=s.toLowerCase();
+  if(/^(organization confidential|organization not parsed|our divisions|executive search|higher education|tbd|n\/a|unknown)$/.test(l))return '';
+  if(/opens in new tab|click here|apply now/i.test(s))return '';
+  if(/^\d{4}$/.test(s))return '';
+  if(/^a\s+(well-established|leading|growing|dynamic|national|reputable)/i.test(s))return '';
+  return s;
+}
+function renderLikelySearches(){
+  const el=$('#likelySearches');if(!el)return;
+  const hj=(history.jobs||[]);
+  const byOrg={};
+  hj.forEach(function(j){
+    const name=cleanOrgName(j.organization);
+    if(!name)return;
+    const k=name.toLowerCase();
+    (byOrg[k]=byOrg[k]||{name:name,jobs:[]}).jobs.push(j);
+  });
+  const active=(payload.jobs||[]);
+  const entries=[];
+  Object.keys(byOrg).forEach(function(k){
+    const g=byOrg[k], jobs=g.jobs;
+    const ids={};jobs.forEach(function(j){ids[j.id]=1;});
+    const n=Object.keys(ids).length;
+    const hasInterim=jobs.some(function(j){return j.succession_reason==='Interim leadership';});
+    if(n<2&&!hasInterim)return;
+    const sorted=jobs.slice().sort(function(a,b){return recency(b).localeCompare(recency(a));});
+    const latest=sorted[0];
+    const hasOpen=jobs.some(function(j){return j.status==='open';});
+    const signals=[];
+    let rank=3;
+    if(n>=2){
+      const first=jobs.map(function(j){return recency(j);}).filter(function(v){return v&&v!=='0000-00-00';}).sort()[0];
+      signals.push(n+' CEO searches captured'+(first?' since '+fmtDate(first,false):''));
+      rank=hasOpen?2:1;
+    }
+    if(hasInterim){
+      const dj=jobs.filter(function(j){return j.succession_reason==='Interim leadership';})
+        .map(function(j){return recency(j);}).filter(function(v){return v&&v!=='0000-00-00';}).sort().pop();
+      signals.push('Interim leadership noted'+(dj?' '+fmtDate(dj,false):''));
+      rank=0;
+    }
+    const sec=(sectorTags(latest)[0]||''), tier=sizeTier(latest);
+    if(sec&&tier&&tier!=='Unknown'){
+      const peers=active.filter(function(j){return j.id!==latest.id&&(sectorTags(j)[0]||'')===sec&&sizeTier(j)===tier;}).length;
+      if(peers>=3)signals.push(peers+' peer orgs ('+sec+', '+tier+') actively searching');
+    }
+    entries.push({name:g.name,latest:latest,signals:signals,rank:rank});
+  });
+  entries.sort(function(a,b){return a.rank-b.rank||b.signals.length-a.signals.length;});
+  const top=entries.slice(0,8);
+  el.innerHTML=top.map(function(e){
+    const j=e.latest;
+    const sec=(sectorTags(j)[0]||'Sector not classified'), tier=sizeTier(j);
+    return '<article class="op-card" data-id="'+esc(j.id)+'" data-url="'+esc(j.url||j.source_url||'#')+'" tabindex="0" role="link" aria-label="Pre-search signal: '+esc(e.name)+'">'
+      +'<div class="op-kicker">Pre-search signal</div>'
+      +'<h3 class="op-title">'+esc(e.name)+'</h3>'
+      +'<div class="op-org">'+esc(sec)+' \u00b7 '+esc(tier)+'</div>'
+      +'<div class="op-meta">'+e.signals.map(function(s){return '<span>'+esc(s)+'</span>';}).join('')+'</div>'
+      +'<div class="op-foot" style="color:var(--teal);font-weight:700">Why listed: '+esc(e.signals[0])+'</div>'
+      +'</article>';
+  }).join('')||'<div class="empty">No strong pre-search signals right now.</div>';
+  bindCards(el);
+}
