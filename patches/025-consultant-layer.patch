+// ---- Consultant layer ----
+// Data contract: a job record may carry `consultant` (name), `consultant_title` and
+// `consultant_url` (bio link). Evidence-text extraction below is intentionally strict:
+// a name is only accepted when adjacent to a senior search title, to avoid false
+// positives from navigation copy ("Contact Us", "Our Team").
+const CONSULTANT_STOPWORDS=new Set(['our team','contact us','search team','executive search','leadership team','about us','learn more','read more','meet the team']);
+const CONSULTANT_NAME_BAD=new Set(['why','with','us','our','the','and','for','from','human','resources','executive','officer','operations','finance','marketing','development','director','manager','assistant','associate','senior','chief','lead','team','search','leadership','talent','people','business','strategy','client','customer','contact']);
+function extractConsultant(ev){
+  if(!ev||typeof ev!=='string')return null;
+  const re=/([A-Z][a-z]+(?: [A-Z][a-z.'-]+){1,2}),?\s+(?:is |as )?(Managing Director|Managing Partner|Senior Managing Director|Principal|Senior Principal|Senior Consultant|Search Consultant|Executive Search Consultant|Senior Partner|Partner)(?![a-z])/g;
+  let m;
+  while((m=re.exec(ev))){
+    const before=ev.slice(Math.max(0,m.index-14),m.index);
+    if(/[&]/.test(before))continue;
+    const name=m[1].replace(/\.$/,'').trim();
+    const words=name.toLowerCase().split(/\s+/);
